---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ValueProp from '../components/ValueProp.astro';
import Treatments from '../components/Treatments.astro';
import Technology from '../components/Technology.astro';
import Team from '../components/Team.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import EvaluationForm from '../components/EvaluationForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sonrisa Nova | Odontología de Alta Precisión & Estética Dental">

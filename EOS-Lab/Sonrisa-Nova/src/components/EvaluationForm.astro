---

<section id="valoracion" class="section-padding evaluation-section">
  <div class="container">
    <div class="evaluation-wrapper glass-panel">
      <div class="evaluation-header">
        <h2>Solicita tu Valoración Odontológica</h2>
        <p>
          Ingresa tus datos básicos y nuestro equipo de admisiones se comunicará directamente para agendar tu consulta.
        </p>
      </div>

      <form id="evaluationForm" class="evaluation-form">
        <div class="form-grid">
          <div class="form-group">
            <label for="nombre">Nombre Completo</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej: María Rodríguez" />
          </div>

          <div class="form-group">
            <label for="contacto">Teléfono o Celular</label>
            <input type="tel" id="contacto" name="contacto" required placeholder="Ej: 300 123 4567" />
          </div>

          <div class="form-group">
            <label for="servicio">Tratamiento de Interés General</label>
            <select id="servicio" name="servicio" required>
              <option value="Valoración General">Valoración Diagnóstica General</option>
              <option value="Diseño de Sonrisa">Diseño de Sonrisa & Estética</option>
              <option value="Implantes Dentales">Implantes Dentales 3D</option>
              <option value="Ortodoncia Invisible">Ortodoncia Invisible</option>
              <option value="Higiene Profiláctica">Higiene & Limpieza Dental</option>
            </select>
          </div>
        </div>

        <div class="privacy-consent-group">
          <label class="checkbox-label">
            <input type="checkbox" id="privacyConsent" required />
            <span>Acepto compartir mi nombre y contacto con Sonrisa Nova exclusivamente para la coordinación de mi cita médica vía WhatsApp. (Minimización de datos biomédicos).</span>
          </label>
        </div>

        <div class="form-action">
          <button type="submit" id="submitBtn" class="btn-primary btn-submit">
            <span>Coordinar Cita vía WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- LSN-002: External CTA Data Integrity Pattern + Privacy Minimization Gate -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('evaluationForm');
    const consent = document.getElementById('privacyConsent');
    
    if (form && consent) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        if (!consent.checked) {
          alert('Por favor acepte el consentimiento explícito de privacidad para continuar.');
          return;
        }

        const nombre = document.getElementById('nombre').value;
        const contacto = document.getElementById('contacto').value;
        const servicio = document.getElementById('servicio').value;
        
        const message = `Hola Sonrisa Nova, mi nombre es ${nombre} (${contacto}). Quisiera solicitar una valoración odontológica para: ${servicio}.`;
        const encodedMessage = encodeURIComponent(message);
        const whatsappUrl = `https://wa.me/573009998877?text=${encodedMessage}`;
        
        window.open(whatsappUrl, '_blank');
      });
    }
  });
</script>

<style>
  .evaluation-section {
    background: linear-gradient(180deg, var(--color-bg) 0%, #ffffff 100%);
  }

  .evaluation-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 3.5rem 3rem;
  }

  .evaluation-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .evaluation-header h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .evaluation-header p {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
  }

  .form-group input, .form-group select {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.95rem;
    background-color: #ffffff;
    color: var(--color-text);
  }

  .form-group input:focus, .form-group select:focus {
    outline: 2px solid var(--color-accent);
    border-color: transparent;
  }

  .privacy-consent-group {
    margin-bottom: 2rem;
    padding: 1rem;
    background-color: rgba(13, 148, 136, 0.05);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
    width: 16px;
    height: 16px;
  }

  .form-action {
    text-align: center;
  }

  .btn-submit {
    width: 100%;
    max-width: 450px;
    padding: 1rem;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .evaluation-wrapper {
      padding: 2rem 1.5rem;
    }
  }
</style>

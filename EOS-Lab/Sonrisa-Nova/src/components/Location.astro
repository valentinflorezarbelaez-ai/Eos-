<section class="section-padding location-section">
  <div class="container">
    <div class="location-wrapper glass-panel">
      <div class="location-info">
        <h2>Visítanos en Nuestra Sede</h2>
        <p class="location-desc">Instalaciones de primer nivel diseñadas para brindarte confort y privacidad durante tu atención.</p>

        <div class="info-group">
          <strong>Dirección:</strong>
          <span>Av. El Poblado #14-25, Torre Médica Milla de Oro, Consultorio 802, Medellín</span>
        </div>

        <div class="info-group">
          <strong>Horario de Atención:</strong>
          <span>Lunes a Viernes: 8:00 AM – 7:00 PM<br />Sábados: 8:00 AM – 1:00 PM</span>
        </div>

        <div class="info-group">
          <strong>Contacto Directo:</strong>
          <span>+57 300 999 8877 | info@sonrisanova.com</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location-section {
    background-color: var(--color-bg);
  }

  .location-wrapper {
    padding: 3.5rem 3rem;
  }

  .location-info h2 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .location-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .info-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .info-group strong {
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  .info-group span {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .location-wrapper {
      padding: 2rem 1.5rem;
    }
  }
</style>

---
---

<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="badge-trust">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Odontología de Alta Precisión & Estética Dental</span>
      </div>
      <h1>Redefinimos tu Sonrisa con Tecnología Avanzada y Cuidado Humano</h1>
      <p class="hero-subtitle">
        Diseño de sonrisa digital, implantes guiados por 3D y alineación invisible. Experimenta una atención odontológica sin dolor en un entorno diseñado para tu bienestar.
      </p>
      <div class="hero-actions">
        <a href="#valoracion" class="btn-primary">
          <span>Solicitar Valoración Prioritaria</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
      <div class="trust-stats">
        <div class="stat-item">
          <span class="stat-num">+5.000</span>
          <span class="stat-label">Sonrisas Transformadas</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">99,4%</span>
          <span class="stat-label">Satisfacción en Pacientes</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">15+</span>
          <span class="stat-label">Años de Experiencia</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 6rem 0 4rem;
    background: radial-gradient(circle at 80% 20%, rgba(13, 148, 136, 0.08) 0%, transparent 50%),
                linear-gradient(180deg, #ffffff 0%, var(--color-bg) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    max-width: 800px;
  }

  .badge-trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(13, 148, 136, 0.1);
    color: var(--color-accent);
    padding: 0.4rem 0.9rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .hero-actions {
    margin-bottom: 3rem;
  }

  .trust-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background-color: var(--color-border);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }
    .trust-stats {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .stat-divider {
      display: none;
    }
  }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.local/schemas/local/hitl-receipt.local.schema.json",
  "title": "EOS HITL Receipt (local governed MVP)",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "decision",
    "approver",
    "gate_id",
    "authority_granted",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "receipt_id": { "type": "string", "pattern": "^HITL-" },
    "decision": {
      "type": "string",
      "enum": ["approve", "approve_with_conditions", "reject", "revoke", "defer"]
    },
    "approver": {
      "type": "object",
      "required": ["identity", "authentication_ref"],
      "properties": {
        "identity": { "type": "string" },
        "authentication_ref": { "type": "string" }
      }
    },
    "gate_id": { "type": "string" },
    "scope": { "type": "object" },
    "authority_granted": {
      "type": "object",
      "required": ["monotonicity_rule"],
      "properties": {
        "level": { "type": "string" },
        "monotonicity_rule": { "type": "string" }
      }
    },
    "evidence_reviewed": { "type": "array" },
    "issued_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "epistemic_class": { "type": "string" },
    "reason": { "type": "string" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSToolSelectionEngineSchema",
  "type": "object",
  "required": [
    "version",
    "scoring_weights",
    "evaluation_rules"
  ],
  "properties": {
    "version": { "type": "string" },
    "scoring_weights": {
      "type": "object",
      "properties": {
        "capability_fit": { "type": "number" },
        "compatibility": { "type": "number" },
        "reliability": { "type": "number" },
        "latency": { "type": "number" },
        "cost": { "type": "number" },
        "security": { "type": "number" },
        "evidence_quality": { "type": "number" },
        "reversibility": { "type": "number" },
        "availability": { "type": "number" },
        "historical_performance": { "type": "number" },
        "provider_trust": { "type": "number" },
        "permission_fit": { "type": "number" }
      }
    },
    "evaluation_rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSPatternSchema",
  "type": "object",
  "required": [
    "pattern_id",
    "name",
    "problem",
    "context",
    "forces",
    "mechanism",
    "implementation_shape",
    "benefits",
    "tradeoffs",
    "risks",
    "anti_patterns",
    "adoption_conditions",
    "evidence",
    "organizations_using_it",
    "maturity",
    "confidence",
    "eos_relevance",
    "status"
  ],
  "properties": {
    "pattern_id": { "type": "string" },
    "name": { "type": "string" },
    "problem": { "type": "string" },
    "context": { "type": "string" },
    "forces": { "type": "array", "items": { "type": "string" } },
    "mechanism": { "type": "string" },
    "implementation_shape": { "type": "string" },
    "benefits": { "type": "array", "items": { "type": "string" } },
    "tradeoffs": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "anti_patterns": { "type": "array", "items": { "type": "string" } },
    "adoption_conditions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "organizations_using_it": { "type": "array", "items": { "type": "string" } },
    "maturity": { "type": "string", "enum": ["MATURE", "EMERGING", "EXPERIMENTAL"] },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "eos_relevance": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "status": { "type": "string", "enum": ["OBSERVED", "EMERGING", "SUPPORTED", "VALIDATED", "ADOPTED", "REJECTED", "DEPRECATED"] }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSReleaseGateStateMachineSchema",
  "version": "1.0.0",
  "states": [
    "RELEASE_RECEIVED",
    "READINESS_ANALYSIS",
    "REQUIREMENTS_REVIEW",
    "SPECIFICATION_REVIEW",
    "ARCHITECTURE_REVIEW",
    "IMPLEMENTATION_REVIEW",
    "TESTING_REVIEW",
    "SECURITY_REVIEW",
    "ACCESSIBILITY_REVIEW",
    "PERFORMANCE_REVIEW",
    "OBSERVABILITY_REVIEW",
    "ROLLBACK_REVIEW",
    "EVIDENCE_REVIEW",
    "AUDIT_REVIEW",
    "RELEASE_CANDIDATE",
    "RELEASE_APPROVED",
    "RELEASE_BLOCKED",
    "RELEASE_REJECTED",
    "REMEDIATION_REQUIRED",
    "ROLLBACK_REQUIRED",
    "ROLLED_BACK"
  ],
  "allowed_transitions": [
    { "from": "RELEASE_RECEIVED", "to": "READINESS_ANALYSIS" },
    { "from": "READINESS_ANALYSIS", "to": "REQUIREMENTS_REVIEW" },
    { "from": "REQUIREMENTS_REVIEW", "to": "SPECIFICATION_REVIEW" },
    { "from": "SPECIFICATION_REVIEW", "to": "ARCHITECTURE_REVIEW" },
    { "from": "ARCHITECTURE_REVIEW", "to": "IMPLEMENTATION_REVIEW" },
    { "from": "IMPLEMENTATION_REVIEW", "to": "TESTING_REVIEW" },
    { "from": "TESTING_REVIEW", "to": "SECURITY_REVIEW" },
    { "from": "SECURITY_REVIEW", "to": "ACCESSIBILITY_REVIEW" },
    { "from": "ACCESSIBILITY_REVIEW", "to": "PERFORMANCE_REVIEW" },
    { "from": "PERFORMANCE_REVIEW", "to": "OBSERVABILITY_REVIEW" },
    { "from": "OBSERVABILITY_REVIEW", "to": "ROLLBACK_REVIEW" },
    { "from": "ROLLBACK_REVIEW", "to": "EVIDENCE_REVIEW" },
    { "from": "EVIDENCE_REVIEW", "to": "AUDIT_REVIEW" },
    { "from": "AUDIT_REVIEW", "to": "RELEASE_CANDIDATE" },
    { "from": "RELEASE_CANDIDATE", "to": "RELEASE_APPROVED" }
  ]
}

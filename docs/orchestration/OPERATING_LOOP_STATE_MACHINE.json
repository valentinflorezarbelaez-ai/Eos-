{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSOperatingLoopStateMachineSchema",
  "version": "1.0.0",
  "states": [
    "RECEIVED",
    "DISCOVERING",
    "RESEARCHING",
    "REQUIREMENTS_READY",
    "SPECIFICATION_READY",
    "ARCHITECTURE_READY",
    "STRATEGIES_READY",
    "DECISION_READY",
    "AGENTS_ASSIGNED",
    "CAPABILITIES_RESOLVED",
    "TOOLS_RESOLVED",
    "AUTHORIZATION_PENDING",
    "AUTHORIZED",
    "PLANNED",
    "EXECUTING",
    "VERIFYING",
    "EVIDENCE_PENDING",
    "AUDITING",
    "RELEASE_REVIEW",
    "LEARNING",
    "SELF_EVALUATING",
    "EVOLUTION_PENDING",
    "COMPLETED",
    "BLOCKED",
    "FAILED",
    "ABORTED",
    "ROLLED_BACK"
  ],
  "allowed_transitions": [
    { "from": "RECEIVED", "to": "DISCOVERING" },
    { "from": "DISCOVERING", "to": "RESEARCHING" },
    { "from": "RESEARCHING", "to": "REQUIREMENTS_READY" },
    { "from": "REQUIREMENTS_READY", "to": "SPECIFICATION_READY" },
    { "from": "SPECIFICATION_READY", "to": "ARCHITECTURE_READY" },
    { "from": "ARCHITECTURE_READY", "to": "STRATEGIES_READY" },
    { "from": "STRATEGIES_READY", "to": "DECISION_READY" },
    { "from": "DECISION_READY", "to": "AGENTS_ASSIGNED" },
    { "from": "AGENTS_ASSIGNED", "to": "CAPABILITIES_RESOLVED" },
    { "from": "CAPABILITIES_RESOLVED", "to": "TOOLS_RESOLVED" },
    { "from": "TOOLS_RESOLVED", "to": "AUTHORIZATION_PENDING" },
    { "from": "AUTHORIZATION_PENDING", "to": "AUTHORIZED" },
    { "from": "AUTHORIZED", "to": "PLANNED" },
    { "from": "PLANNED", "to": "EXECUTING" },
    { "from": "EXECUTING", "to": "VERIFYING" },
    { "from": "VERIFYING", "to": "EVIDENCE_PENDING" },
    { "from": "EVIDENCE_PENDING", "to": "AUDITING" },
    { "from": "AUDITING", "to": "RELEASE_REVIEW" },
    { "from": "RELEASE_REVIEW", "to": "LEARNING" },
    { "from": "LEARNING", "to": "SELF_EVALUATING" },
    { "from": "SELF_EVALUATING", "to": "EVOLUTION_PENDING" },
    { "from": "EVOLUTION_PENDING", "to": "COMPLETED" }
  ]
}

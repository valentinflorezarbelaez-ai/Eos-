{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSOperatingLoopContractSchema",
  "type": "object",
  "required": [
    "loopId",
    "missionId",
    "lifecycleState",
    "objective",
    "successCriteria",
    "constraints",
    "riskProfile",
    "autonomyLevel",
    "strategy",
    "agents",
    "capabilities",
    "tools",
    "providers",
    "actions",
    "dependencies",
    "authorization",
    "evidenceRequirements",
    "verificationRequirements",
    "rollbackRequirements",
    "learningRequirements",
    "releaseRequirements"
  ],
  "properties": {
    "loopId": { "type": "string" },
    "missionId": { "type": "string" },
    "lifecycleState": { "type": "string" },
    "objective": { "type": "string" },
    "successCriteria": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "riskProfile": { "type": "string" },
    "autonomyLevel": { "type": "integer" },
    "strategy": { "type": "string" },
    "agents": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "providers": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "authorization": { "type": "string" },
    "evidenceRequirements": { "type": "array", "items": { "type": "string" } },
    "verificationRequirements": { "type": "array", "items": { "type": "string" } },
    "rollbackRequirements": { "type": "array", "items": { "type": "string" } },
    "learningRequirements": { "type": "array", "items": { "type": "string" } },
    "releaseRequirements": { "type": "array", "items": { "type": "string" } }
  }
}

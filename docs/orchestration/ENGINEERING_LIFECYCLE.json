{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOSEngineeringLifecycleSchema",
  "version": "1.0.0",
  "states": [
    "MISSION_RECEIVED",
    "DISCOVERY",
    "RESEARCH",
    "REQUIREMENTS",
    "SPECIFICATION",
    "ARCHITECTURE",
    "PLANNING",
    "AGENT_ASSIGNMENT",
    "CAPABILITY_MATCHING",
    "TOOL_SELECTION",
    "AUTHORIZATION",
    "EXECUTION",
    "TESTING",
    "VERIFICATION",
    "EVIDENCE",
    "AUDIT",
    "LEARNING",
    "RELEASE_REVIEW",
    "COMPLETED",
    "BLOCKED",
    "ABORTED",
    "FAILED",
    "ROLLED_BACK"
  ],
  "allowed_transitions": [
    { "from": "MISSION_RECEIVED", "to": "DISCOVERY" },
    { "from": "DISCOVERY", "to": "RESEARCH" },
    { "from": "RESEARCH", "to": "REQUIREMENTS" },
    { "from": "REQUIREMENTS", "to": "SPECIFICATION" },
    { "from": "SPECIFICATION", "to": "ARCHITECTURE" },
    { "from": "ARCHITECTURE", "to": "PLANNING" },
    { "from": "PLANNING", "to": "AGENT_ASSIGNMENT" },
    { "from": "AGENT_ASSIGNMENT", "to": "CAPABILITY_MATCHING" },
    { "from": "CAPABILITY_MATCHING", "to": "TOOL_SELECTION" },
    { "from": "TOOL_SELECTION", "to": "AUTHORIZATION" },
    { "from": "AUTHORIZATION", "to": "EXECUTION" },
    { "from": "EXECUTION", "to": "TESTING" },
    { "from": "TESTING", "to": "VERIFICATION" },
    { "from": "VERIFICATION", "to": "EVIDENCE" },
    { "from": "EVIDENCE", "to": "AUDIT" },
    { "from": "AUDIT", "to": "LEARNING" },
    { "from": "LEARNING", "to": "RELEASE_REVIEW" },
    { "from": "RELEASE_REVIEW", "to": "COMPLETED" }
  ]
}
